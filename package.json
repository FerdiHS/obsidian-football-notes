{
	"name": "football-notes",
	"version": "0.2.0",
	"description": "Create structured football notes in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test-runner.mjs",
		"check": "npm run test && npm run build && npm run lint && npm run format:check",
		"prepare": "husky",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"version": "node version-bump.mjs sync && git add manifest.json versions.json",
		"version:sync": "node version-bump.mjs sync",
		"version:check": "node version-bump.mjs check",
		"lint": "eslint ."
	},
	"lint-staged": {
		"**/*.{ts,js,mjs,cjs,mts}": [
			"prettier --write",
			"eslint --fix"
		],
		"**/*.{md,json,yml,yaml,css}": [
			"prettier --write"
		]
	},
	"keywords": [],
	"license": "0-BSD",
	"engines": {
		"node": ">=20.17"
	},
	"dependencies": {
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^20.17.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"husky": "^9.1.7",
		"jiti": "2.6.1",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"obsidian": "^1.10.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	}
}
